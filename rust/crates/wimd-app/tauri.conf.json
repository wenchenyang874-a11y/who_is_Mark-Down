{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WIMD Rust 预览版",
  "version": "2.0.0",
  "identifier": "com.wenchenyang.wimd",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WIMD",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "publisher": "wenchenyang",
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../THIRD-PARTY-DEPENDENCIES.md": "THIRD-PARTY-DEPENDENCIES.md",
      "windows/Capture-Startup.ps1": "Diagnostics/Capture-Startup.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "WIMD Rust 预览版"
      }
    }
  }
}
