<UserControl x:Class="WhoIsMarkdown.App.Controls.BackgroundSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="自定义背景" />
        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="图片会先复制到 WIMD 本地目录，不上传。调整后点击“应用”或“保存”生效。" />
        <Border Height="210" CornerRadius="12" ClipToBounds="True" SizeChanged="ThumbnailSizeChanged" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceMutedBrush}">
            <Grid>
                <Image x:Name="BackgroundThumbnail" Stretch="Uniform" />
                <TextBlock x:Name="EmptyBackgroundText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="还没有选择背景图片" />
            </Grid>
        </Border>
        <TextBlock x:Name="BackgroundFileNameText" Margin="0,12,0,10" TextTrimming="CharacterEllipsis" Text="尚未选择图片" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="SelectBackgroundButton" Padding="16,7" Content="选择图片" Click="SelectBackground_Click" />
            <Button x:Name="RemoveBackgroundButton" Margin="10,0,0,0" Padding="16,7" Content="移除" Click="RemoveBackground_Click" />
        </StackPanel>
        <TextBlock x:Name="BackgroundVisibilityText" Margin="0,22,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Slider x:Name="BackgroundVisibilitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                AutomationProperties.Name="背景可见度" ToolTip="0% 完全隐藏，100% 最清晰" ValueChanged="VisibilityChanged" />
        <TextBlock x:Name="StatusText" Margin="0,14,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
