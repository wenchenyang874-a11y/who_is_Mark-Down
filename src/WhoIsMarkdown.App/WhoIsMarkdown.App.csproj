<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AssemblyName>WIMD</AssemblyName>
    <RootNamespace>WhoIsMarkdown.App</RootNamespace>
    <Product>WIMD</Product>
    <AssemblyTitle>WIMD</AssemblyTitle>
    <Description>Offline-first Markdown editor with real-time preview.</Description>
    <Version>1.6.3</Version>
    <FileVersion>1.6.3.0</FileVersion>
    <AssemblyVersion>1.6.3.0</AssemblyVersion>
    <ApplicationIcon Condition="Exists('..\..\assets\app.ico')">..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhoIsMarkdown.Core\WhoIsMarkdown.Core.csproj" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\preview.css" />
    <Resource Include="..\..\assets\app-icon.png" Link="Resources\app-icon.png" />
  </ItemGroup>
</Project>
