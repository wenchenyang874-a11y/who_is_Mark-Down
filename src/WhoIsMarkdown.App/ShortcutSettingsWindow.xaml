<Window x:Class="WhoIsMarkdown.App.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置 - WIMD"
        Width="620"
        Height="650"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F5FA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="快捷键" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,14"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="点击某一项的组合键按钮，然后按下新的快捷键。重复组合和保留键不会被保存。"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <ListView x:Name="ShortcutList"
                      BorderThickness="0"
                      ItemsSource="{Binding}">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="260" Header="功能" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Width="260" Header="当前快捷键">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button MinWidth="190"
                                            Height="28"
                                            Padding="10,0"
                                            HorizontalContentAlignment="Left"
                                            Content="{Binding GestureText}"
                                            Tag="{Binding}"
                                            Click="StartCapture_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="3"
                   MinHeight="22"
                   Margin="2,10,2,4"
                   Foreground="#C42B1C"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    MinWidth="100"
                    Height="34"
                    Content="恢复默认"
                    Click="ResetDefaults_Click" />
            <Button Grid.Column="2"
                    MinWidth="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="取消"
                    IsCancel="True" />
            <Button Grid.Column="3"
                    MinWidth="88"
                    Height="34"
                    Content="保存"
                    IsDefault="True"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>