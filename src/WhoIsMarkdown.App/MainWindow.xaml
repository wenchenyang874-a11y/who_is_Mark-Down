<Window x:Class="WhoIsMarkdown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:viewModels="clr-namespace:WhoIsMarkdown.App.ViewModels"
        xmlns:webView="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        x:Name="RootWindow"
        Title="{Binding WindowTitle}"
        Icon="Resources/app-icon.png"
        Width="1320"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Background="#F4F5FA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Image x:Name="AppBackgroundImage"
               Stretch="UniformToFill"
               Opacity="0"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Background="#62F4F5FA" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0"
                  Height="30"
                  Padding="8,0"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Background="#F8FFFFFF">
                <Menu.Resources>
                    <!-- Bug fix: the Windows light theme can otherwise resolve the
                         top-level MenuItem foreground as transparent. -->
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    </Style>
                    <!-- Bug fix: the .NET Fluent theme can suppress the complete
                         top-level MenuItem header presenter. This narrow template owns
                         only the top-level header and popup; submenu items keep the
                         native theme template and command behavior. -->
                    <ControlTemplate x:Key="TopLevelMenuItemTemplate"
                                     TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MenuHeaderBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,2,0,0"
                                        Padding="3"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFD7DCE8"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuHeaderBorder" Property="Background" Value="#12000000" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="MenuHeaderBorder" Property="Background" Value="#18000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                    <Style x:Key="TopLevelMenuItemStyle" TargetType="{x:Type MenuItem}">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Foreground" Value="#182033" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}" />
                    </Style>
                </Menu.Resources>
                <MenuItem Header="文件(_F)" AutomationProperties.Name="文件" Style="{StaticResource TopLevelMenuItemStyle}">
                    <MenuItem x:Name="NewDocumentMenuItem" Header="新建(_N)" InputGestureText="Ctrl+N" Click="New_Click" />
                    <MenuItem x:Name="OpenDocumentMenuItem" Header="打开文件(_O)..." InputGestureText="Ctrl+O" Click="Open_Click" />
                    <MenuItem x:Name="OpenFolderMenuItem" Header="打开文件夹..." AutomationProperties.Name="打开文件夹" Click="OpenFolder_Click" />
                    <MenuItem x:Name="CloseWorkspaceMenuItem" Header="关闭文件夹" IsEnabled="False" Click="CloseWorkspace_Click" />
                    <Separator />
                    <MenuItem x:Name="SaveDocumentMenuItem" Header="保存(_S)" InputGestureText="Ctrl+S" Click="Save_Click" />
                    <MenuItem x:Name="SaveAsDocumentMenuItem" Header="另存为(_A)..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                    <Separator />
                    <MenuItem x:Name="ExportPdfMenuItem" Header="导出为 PDF..." Click="ExportPdf_Click" />
                    <Separator />
                    <MenuItem Header="退出(_X)" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="编辑(_E)" AutomationProperties.Name="编辑" Style="{StaticResource TopLevelMenuItemStyle}" SubmenuOpened="EditMenu_SubmenuOpened">
                    <MenuItem x:Name="UndoMenuItem" Header="撤销(_U)" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                    <MenuItem x:Name="RedoMenuItem" Header="重做(_R)" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                    <Separator />
                    <MenuItem x:Name="CutMenuItem" Header="剪切(_T)" InputGestureText="Ctrl+X" Click="Cut_Click" />
                    <MenuItem x:Name="CopyMenuItem" Header="复制(_C)" InputGestureText="Ctrl+C" Click="Copy_Click" />
                    <MenuItem x:Name="PasteMenuItem" Header="粘贴(_P)" InputGestureText="Ctrl+V" Click="Paste_Click" />
                    <MenuItem Header="全选(_A)" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                    <Separator />
                    <MenuItem x:Name="MarkdownFormatMenuItem" Header="Markdown 格式">
                        <MenuItem Header="粗体" InputGestureText="Ctrl+B" Tag="bold" Click="MarkdownFormat_Click" />
                        <MenuItem Header="斜体" InputGestureText="Ctrl+I" Tag="italic" Click="MarkdownFormat_Click" />
                        <MenuItem Header="删除线" InputGestureText="Ctrl+Shift+X" Tag="strike" Click="MarkdownFormat_Click" />
                        <MenuItem Header="行内代码" InputGestureText="Ctrl+E" Tag="inline-code" Click="MarkdownFormat_Click" />
                        <MenuItem Header="代码块" InputGestureText="Ctrl+Shift+K" Tag="code-block" Click="MarkdownFormat_Click" />
                        <Separator />
                        <MenuItem Header="链接" InputGestureText="Ctrl+K" Tag="link" Click="MarkdownFormat_Click" />
                        <MenuItem x:Name="InsertImageMenuItem" Header="选择图片并插入..." InputGestureText="Ctrl+Shift+I" Tag="image" Click="InsertImage_Click" />
                        <Separator />
                        <MenuItem Header="有序列表" InputGestureText="Ctrl+Shift+7" Tag="ordered-list" Click="MarkdownFormat_Click" />
                        <MenuItem Header="无序列表" InputGestureText="Ctrl+Shift+8" Tag="unordered-list" Click="MarkdownFormat_Click" />
                        <MenuItem Header="引用" InputGestureText="Ctrl+Shift+9" Tag="quote" Click="MarkdownFormat_Click" />
                        <MenuItem Header="任务列表" InputGestureText="Ctrl+Shift+L" Tag="task-list" Click="MarkdownFormat_Click" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="视图(_V)" AutomationProperties.Name="视图" Style="{StaticResource TopLevelMenuItemStyle}">
                    <MenuItem x:Name="CycleViewModeMenuItem" Header="循环切换视图" InputGestureText="F9" Click="CycleViewMode_Click" />
                    <Separator />
                    <MenuItem x:Name="PreviewOnlyModeMenuItem" Header="仅预览" IsCheckable="True" Click="PreviewOnlyMode_Click" />
                    <MenuItem x:Name="SplitModeMenuItem" Header="编辑 + 预览" IsCheckable="True" IsChecked="True" Click="SplitMode_Click" />
                    <MenuItem x:Name="EditorOnlyModeMenuItem" Header="仅编辑" IsCheckable="True" Click="EditorOnlyMode_Click" />
                    <Separator />
                    <MenuItem x:Name="RecentPaneMenuItem" Header="显示侧栏" IsCheckable="True" Click="RecentPaneToggle_Click" />
                </MenuItem>
                <MenuItem Header="快捷键(_K)" AutomationProperties.Name="快捷键" Style="{StaticResource TopLevelMenuItemStyle}">
                    <MenuItem Header="快捷键设置..." Click="Shortcuts_Click" />
                </MenuItem>
                <MenuItem Header="设置(_S)" AutomationProperties.Name="设置" Style="{StaticResource TopLevelMenuItemStyle}">
                    <MenuItem Header="图片设置..." Click="ImageSettings_Click" />
                    <MenuItem Header="自定义背景..." Click="BackgroundSettings_Click" />
                </MenuItem>
                <MenuItem Header="帮助(_H)" AutomationProperties.Name="帮助" Style="{StaticResource TopLevelMenuItemStyle}">
                    <MenuItem Header="关于 WIMD" Click="About_Click" />
                </MenuItem>
            </Menu>

            <Grid Grid.Row="1" Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecentPaneColumn" Width="252" />
                    <ColumnDefinition x:Name="RecentPaneGutterColumn" Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RecentPane" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid x:Name="RecentPaneContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="14,10,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="最近打开" />
                                    <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="打开文件夹后切换为资源管理器" />
                                </StackPanel>
                                <Button Grid.Column="1" AutomationProperties.Name="收起侧栏" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="收起侧栏" Click="CollapseRecentPane_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="8,0,8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentFiles, ElementName=RootWindow}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Tag="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource RecentOpenButtonStyle}" Click="OpenRecentFile_Click">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="打开" Tag="{Binding Path}" IsEnabled="{Binding IsAvailable}" Click="OpenRecentFile_Click" />
                                                                <MenuItem Header="在文件资源管理器中显示" Tag="{Binding Path}" IsEnabled="{Binding IsAvailable}" Click="RevealRecentFile_Click" />
                                                                <Separator />
                                                                <MenuItem Header="复制文件路径" Tag="{Binding Path}" Click="CopyRecentFilePath_Click" />
                                                                <MenuItem Header="复制所在文件夹路径" Tag="{Binding DirectoryPath}" Click="CopyRecentDirectoryPath_Click" />
                                                                <MenuItem Header="复制文件名" Tag="{Binding DisplayName}" Click="CopyRecentFileName_Click" />
                                                                <Separator />
                                                                <MenuItem Header="移出最近记录（不删除文件）" Tag="{Binding Path}" Click="RemoveRecentFile_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <StackPanel HorizontalAlignment="Stretch">
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#9299AA" Text="{Binding LastOpenedDisplay}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Width="30" Height="30" Margin="2,0,0,0" VerticalAlignment="Center" Tag="{Binding Path}" ToolTip="移出最近文件（不删除原文件）" Style="{StaticResource CompactToolbarButtonStyle}" Click="RemoveRecentFile_Click">
                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel x:Name="RecentFilesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#A7ADBC" Text="&#xE81C;" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="还没有最近文件" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#9299AA" Text="打开文档后会显示在这里" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="WorkspacePaneContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="12,9,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="WorkspaceFolderNameText" Style="{StaticResource PanelTitleTextStyle}" Text="工作区" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WorkspaceFolderPathText" Margin="0,3,0,0" FontSize="9" Foreground="#9299AA" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" AutomationProperties.Name="收起侧栏" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="收起侧栏" Click="CollapseRecentPane_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" />
                                </Button>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="8,2,8,5" Orientation="Horizontal">
                                <Button Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="新建 Markdown 文件" Click="NewWorkspaceFile_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7C3;" />
                                </Button>
                                <Button Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="新建文件夹" Click="NewWorkspaceDirectory_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8F4;" />
                                </Button>
                                <Button Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="刷新工作区" Click="RefreshWorkspace_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" />
                                </Button>
                                <Button Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="关闭文件夹" Click="CloseWorkspace_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" />
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="5,0,5,7">
                                <TreeView x:Name="WorkspaceTree"
                                          AutomationProperties.Name="工作区文件树"
                                          Padding="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ItemsSource="{Binding WorkspaceItems, ElementName=RootWindow}"
                                          SelectedItemChanged="WorkspaceTree_SelectedItemChanged"
                                          PreviewMouseRightButtonDown="WorkspaceTree_PreviewMouseRightButtonDown"
                                          KeyDown="WorkspaceTree_KeyDown"
                                          TreeViewItem.Expanded="WorkspaceTree_Expanded">
                                    <TreeView.ContextMenu>
                                        <ContextMenu AutomationProperties.Name="工作区根目录菜单">
                                            <MenuItem Header="新建 Markdown 文件"
                                                      AutomationProperties.Name="在工作区根目录新建 Markdown 文件"
                                                      Click="NewWorkspaceRootFile_Click" />
                                            <MenuItem Header="新建文件夹"
                                                      AutomationProperties.Name="在工作区根目录新建文件夹"
                                                      Click="NewWorkspaceRootDirectory_Click" />
                                            <MenuItem Header="刷新"
                                                      AutomationProperties.Name="刷新工作区"
                                                      Click="RefreshWorkspace_Click" />
                                            <Separator />
                                            <MenuItem Header="在文件资源管理器中显示"
                                                      AutomationProperties.Name="在文件资源管理器中显示工作区根目录"
                                                      Click="RevealWorkspaceRoot_Click" />
                                            <MenuItem Header="复制路径"
                                                      AutomationProperties.Name="复制工作区根目录路径"
                                                      Click="CopyWorkspaceRootPath_Click" />
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,1" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.Resources>
                                        <!-- The native TreeView highlight is suppressed so the header can
                                             render WIMD's rounded hover and selection surfaces consistently. -->
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1D2433" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1D2433" />
                                        <HierarchicalDataTemplate DataType="{x:Type viewModels:WorkspaceTreeItemViewModel}" ItemsSource="{Binding Children}">
                                            <Border MinHeight="29"
                                                    Margin="0,1,2,1"
                                                    Padding="6,2"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    ToolTip="{Binding Path}"
                                                    MouseLeftButtonDown="WorkspaceTreeItem_MouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                                                <Setter Property="Background" Value="#F3F4F8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                                                <Setter Property="Background" Value="#ECE9FF" />
                                                                <Setter Property="BorderBrush" Value="#D4CEFF" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True" />
                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="BorderBrush" Value="#8C7CF0" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="打开" Tag="{Binding}" IsEnabled="{Binding IsFile}" Click="OpenWorkspaceEntry_Click" />
                                                        <Separator />
                                                        <MenuItem Header="新建 Markdown 文件" Tag="{Binding}" IsEnabled="{Binding IsDirectory}" Click="NewWorkspaceFile_Click" />
                                                        <MenuItem Header="新建文件夹" Tag="{Binding}" IsEnabled="{Binding IsDirectory}" Click="NewWorkspaceDirectory_Click" />
                                                        <MenuItem Header="重命名" Tag="{Binding}" IsEnabled="{Binding IsActionable}" Click="RenameWorkspaceEntry_Click" />
                                                        <MenuItem Header="删除" AutomationProperties.Name="删除实际文件或文件夹" Tag="{Binding}" IsEnabled="{Binding IsActionable}" Click="DeleteWorkspaceEntry_Click" />
                                                        <Separator />
                                                        <MenuItem Header="在文件资源管理器中显示" Tag="{Binding}" IsEnabled="{Binding IsActionable}" Click="RevealWorkspaceEntry_Click" />
                                                        <MenuItem Header="复制路径" Tag="{Binding}" IsEnabled="{Binding IsActionable}" Click="CopyWorkspacePath_Click" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Width="20" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#687086" Text="{Binding IconGlyph}" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                                <StackPanel x:Name="WorkspaceEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="25" Foreground="#A7ADBC" Text="&#xE838;" />
                                    <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="没有 Markdown 文件" />
                                    <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#9299AA" Text="可在上方新建文件或文件夹" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Button x:Name="ExpandRecentPaneButton"
                        Grid.Column="1"
                        Width="30"
                        Height="34"
                        Margin="3,4,3,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10"
                        AutomationProperties.Name="展开侧栏"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTip="展开侧栏"
                        Visibility="Collapsed"
                        Click="ExpandRecentPane_Click">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" />
                </Button>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,6" Padding="6,3" Style="{StaticResource SurfaceCardStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MarkdownToolbar" Orientation="Horizontal">
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H1" ToolTip="一级标题 (Ctrl+1)" Tag="1" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H2" ToolTip="二级标题 (Ctrl+2)" Tag="2" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H3" ToolTip="三级标题 (Ctrl+3)" Tag="3" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H4" ToolTip="四级标题 (Ctrl+4)" Tag="4" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H5" ToolTip="五级标题 (Ctrl+5)" Tag="5" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H6" ToolTip="六级标题 (Ctrl+6)" Tag="6" Click="Heading_Click" />
                                <Separator Margin="5,4" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" FontWeight="Bold" Content="B" ToolTip="粗体 (Ctrl+B，可再次执行取消)" Tag="bold" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" FontStyle="Italic" Content="I" ToolTip="斜体 (Ctrl+I，可再次执行取消)" Tag="italic" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="S̶" ToolTip="删除线 (Ctrl+Shift+X，可再次执行取消)" Tag="strike" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="❝" ToolTip="引用 (Ctrl+Shift+9)" Tag="quote" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="&lt;/&gt;" ToolTip="行内代码 (Ctrl+E)" Tag="inline-code" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="代码块" ToolTip="代码块 (Ctrl+Shift+K)" Tag="code-block" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="链接" ToolTip="插入链接 (Ctrl+K)" Tag="link" Click="MarkdownFormat_Click" />
                                <Button x:Name="InsertImageToolbarButton" Style="{StaticResource MarkdownToolbarButtonStyle}" Content="图片" ToolTip="选择或粘贴图片 (Ctrl+Shift+I)" Tag="image" Click="InsertImage_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="• 列表" ToolTip="无序列表 (Ctrl+Shift+8)" Tag="unordered-list" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="1. 列表" ToolTip="有序列表 (Ctrl+Shift+7)" Tag="ordered-list" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="☑ 任务" ToolTip="任务列表 (Ctrl+Shift+L)" Tag="task-list" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="表格" ToolTip="插入表格" Tag="table" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="—" ToolTip="分隔线" Tag="separator" Click="MarkdownFormat_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid x:Name="WorkspaceGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="0" />
                            <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="EditorHost" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,0" BorderBrush="#E7EAF1" BorderThickness="0,0,0,1">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <avalonEdit:TextEditor x:Name="Editor"
                                                       Grid.Row="1"
                                                       Padding="14,10"
                                                       Background="#EFFFFFFF"
                                                       Foreground="#1A2235"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="15"
                                                       ShowLineNumbers="True"
                                                       WordWrap="True"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"
                                                       TextChanged="Editor_TextChanged" />
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

                        <Border x:Name="PreviewHost" Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,0" BorderBrush="#E7EAF1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PanelTitleTextStyle}" Text="实时预览" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="7,2" Background="#E5F8F0" CornerRadius="7">
                                            <TextBlock FontSize="9" Foreground="#257A58" Text="离线安全" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <webView:WebView2 x:Name="Preview" Grid.Row="1" PreviewMouseWheel="Preview_PreviewMouseWheel" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Padding="10,4" Background="#F8FFFFFF" BorderBrush="#DDE2EC" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="准备就绪" />
                    <Border Grid.Column="1" Width="1" Height="12" Margin="10,0" Background="#D9DDE6" />
                    <TextBlock x:Name="PathText" Grid.Column="2" VerticalAlignment="Center" Foreground="#858C9E" Text="未保存" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CaretText" Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="行 1，列 1" />
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="BackgroundSettingsPopup" Placement="Center" PlacementTarget="{Binding ElementName=RootWindow}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="310" Padding="18" Background="#FFFCFD" BorderBrush="#D8DDE8" BorderThickness="1" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.18" ShadowDepth="5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="工作区背景" />
                    <TextBlock Margin="0,5,0,14" Foreground="{StaticResource TextSecondaryBrush}" Text="图片仅从本机读取，不会上传。" />
                    <TextBlock x:Name="BackgroundFileNameText" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" Text="尚未选择图片" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="选择图片" Click="SelectBackground_Click" />
                        <Button x:Name="RemoveBackgroundButton" Style="{StaticResource ToolbarButtonStyle}" Content="移除" Click="RemoveBackground_Click" />
                    </StackPanel>
                    <TextBlock x:Name="BackgroundTransparencyText" Margin="0,14,0,5" Foreground="{StaticResource TextSecondaryBrush}" Text="透明度 82%" />
                    <Slider x:Name="BackgroundTransparencySlider" Minimum="0" Maximum="100" TickFrequency="5" Value="82" ValueChanged="BackgroundTransparencySlider_ValueChanged" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
