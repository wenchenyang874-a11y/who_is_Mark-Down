<Window x:Class="WhoIsMarkdown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:webView="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        x:Name="RootWindow"
        Title="{Binding WindowTitle}"
        Icon="/WhoIsMarkdown.App;component/Resources/app-icon.png"
        Width="1320"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Background="#F4F5FA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Image x:Name="AppBackgroundImage"
               Stretch="UniformToFill"
               Opacity="0"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Background="#62F4F5FA" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0" Padding="8,2" Background="#F2FFFFFF">
                <MenuItem Header="文件(_F)">
                    <MenuItem Header="新建(_N)" InputGestureText="Ctrl+N" Click="New_Click" />
                    <MenuItem Header="打开(_O)..." InputGestureText="Ctrl+O" Click="Open_Click" />
                    <Separator />
                    <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="Save_Click" />
                    <MenuItem Header="另存为(_A)..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                    <Separator />
                    <MenuItem Header="退出(_X)" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="编辑(_E)">
                    <MenuItem Header="撤销(_U)" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" />
                    <MenuItem Header="重做(_R)" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" />
                    <Separator />
                    <MenuItem Header="剪切(_T)" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}" />
                    <MenuItem Header="复制(_C)" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}" />
                    <MenuItem Header="粘贴(_P)" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}" />
                </MenuItem>
                <MenuItem Header="视图(_V)">
                    <MenuItem Header="仅预览" InputGestureText="Ctrl+1" Click="PreviewOnlyMode_Click" />
                    <MenuItem Header="编辑 + 预览" InputGestureText="Ctrl+2" Click="SplitMode_Click" />
                    <MenuItem Header="仅编辑" InputGestureText="Ctrl+3" Click="EditorOnlyMode_Click" />
                    <Separator />
                    <MenuItem Header="显示/隐藏最近文件" Click="RecentPaneToggle_Click" />
                    <MenuItem Header="自定义背景..." Click="BackgroundSettings_Click" />
                </MenuItem>
            </Menu>

            <Border Grid.Row="1"
                    Margin="12,10,12,8"
                    Padding="10,7"
                    Background="#F2FFFFFF"
                    BorderBrush="#DDE2EC"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="4,0,16,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Width="30" Height="30" Margin="0,0,9,0" Source="/WhoIsMarkdown.App;component/Resources/app-icon.png" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Who Is Mark-Down" />
                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="LOCAL MARKDOWN STUDIO" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="新建 (Ctrl+N)" Click="New_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE710;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="打开 (Ctrl+O)" Click="Open_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE8E5;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="保存 (Ctrl+S)" Click="Save_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE74E;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal">
                        <ToggleButton x:Name="RecentPaneToggleButton"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      ToolTip="显示或隐藏最近文件"
                                      Click="RecentPaneToggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xE81C;" />
                                <TextBlock Text="最近" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="BackgroundSettingsButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="自定义本地背景"
                                Click="BackgroundSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="&#xEB9F;" />
                                <TextBlock Text="背景" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="4" Padding="3" Background="#E8EAF1" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="PreviewOnlyModeButton"
                                          Style="{StaticResource ModeToggleButtonStyle}"
                                          ToolTip="仅预览 (Ctrl+1)"
                                          Content="预览"
                                          Click="PreviewOnlyMode_Click" />
                            <ToggleButton x:Name="SplitModeButton"
                                          Style="{StaticResource ModeToggleButtonStyle}"
                                          ToolTip="编辑 + 预览 (Ctrl+2)"
                                          Content="分栏"
                                          IsChecked="True"
                                          Click="SplitMode_Click" />
                            <ToggleButton x:Name="EditorOnlyModeButton"
                                          Style="{StaticResource ModeToggleButtonStyle}"
                                          ToolTip="仅编辑 (Ctrl+3)"
                                          Content="编辑"
                                          Click="EditorOnlyMode_Click" />
                        </StackPanel>
                    </Border>

                    <Popup x:Name="BackgroundSettingsPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=BackgroundSettingsButton}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="310"
                                Margin="0,8,0,0"
                                Padding="18"
                                Background="#FFFCFD"
                                BorderBrush="#D8DDE8"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" Opacity="0.18" ShadowDepth="5" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="工作区背景" />
                                <TextBlock Margin="0,5,0,14" Foreground="{StaticResource TextSecondaryBrush}" Text="图片仅从本机读取，不会上传。" />
                                <TextBlock x:Name="BackgroundFileNameText" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" Text="尚未选择图片" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="选择图片" Click="SelectBackground_Click" />
                                    <Button x:Name="RemoveBackgroundButton" Style="{StaticResource ToolbarButtonStyle}" Content="移除" Click="RemoveBackground_Click" />
                                </StackPanel>
                                <TextBlock x:Name="BackgroundTransparencyText" Margin="0,14,0,5" Foreground="{StaticResource TextSecondaryBrush}" Text="透明度 82%" />
                                <Slider x:Name="BackgroundTransparencySlider"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="False"
                                        Value="82"
                                        ValueChanged="BackgroundTransparencySlider_ValueChanged" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="12,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecentPaneColumn" Width="252" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RecentPane" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,14,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="最近打开" />
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="仅保存在这台电脑" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="收起最近文件"
                                    Click="CollapseRecentPane_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentFiles, ElementName=RootWindow}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Tag="{Binding Path}"
                                                        ToolTip="{Binding Path}"
                                                        Style="{StaticResource RecentOpenButtonStyle}"
                                                        Click="OpenRecentFile_Click">
                                                    <StackPanel HorizontalAlignment="Stretch">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#9299AA" Text="{Binding LastOpenedDisplay}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding Path}"
                                                        ToolTip="移出最近文件（不删除原文件）"
                                                        Style="{StaticResource ToolbarButtonStyle}"
                                                        Click="RemoveRecentFile_Click">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="RecentFilesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#A7ADBC" Text="&#xE81C;" />
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="还没有最近文件" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#9299AA" Text="打开文档后会显示在这里" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14,9" Style="{StaticResource SurfaceCardStyle}">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="本地编辑 · 自动预览" />
                        </Grid>
                    </Border>

                    <Grid x:Name="WorkspaceGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="0" />
                            <ColumnDefinition x:Name="SplitterColumn" Width="8" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="EditorHost" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="14,0" BorderBrush="#E7EAF1" BorderThickness="0,0,0,1">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource PanelTitleTextStyle}" Text="MARKDOWN" />
                                </Border>
                                <avalonEdit:TextEditor x:Name="Editor"
                                                       Grid.Row="1"
                                                       Padding="14,10"
                                                       Background="#EFFFFFFF"
                                                       Foreground="#1A2235"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="15"
                                                       ShowLineNumbers="True"
                                                       WordWrap="True"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"
                                                       TextChanged="Editor_TextChanged" />
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="WorkspaceSplitter"
                                      Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns" />

                        <Border x:Name="PreviewHost" Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="14,0" BorderBrush="#E7EAF1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PanelTitleTextStyle}" Text="实时预览" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" Background="#E5F8F0" CornerRadius="8">
                                            <TextBlock FontSize="10" Foreground="#257A58" Text="离线安全" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <webView:WebView2 x:Name="Preview" Grid.Row="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Padding="14,7" Background="#EEFFFFFF" BorderBrush="#DDE2EC" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="准备就绪" />
                    <Border Grid.Column="1" Width="1" Height="14" Margin="12,0" Background="#D9DDE6" />
                    <TextBlock x:Name="PathText" Grid.Column="2" VerticalAlignment="Center" Foreground="#858C9E" Text="未保存" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CaretText" Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="行 1，列 1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
