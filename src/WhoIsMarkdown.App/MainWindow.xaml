<Window x:Class="WhoIsMarkdown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:webView="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        x:Name="RootWindow"
        Title="{Binding WindowTitle}"
        Icon="Resources/app-icon.png"
        Width="1320"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Background="#F4F5FA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Image x:Name="AppBackgroundImage"
               Stretch="UniformToFill"
               Opacity="0"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Background="#62F4F5FA" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0" Padding="8,0" Height="30" Background="#F8FFFFFF">
                <MenuItem Header="文件(_F)">
                    <MenuItem Header="新建(_N)" InputGestureText="Ctrl+N" Click="New_Click" />
                    <MenuItem Header="打开(_O)..." InputGestureText="Ctrl+O" Click="Open_Click" />
                    <Separator />
                    <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="Save_Click" />
                    <MenuItem Header="另存为(_A)..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                    <Separator />
                    <MenuItem Header="退出(_X)" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="编辑(_E)" SubmenuOpened="EditMenu_SubmenuOpened">
                    <MenuItem x:Name="UndoMenuItem" Header="撤销(_U)" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                    <MenuItem x:Name="RedoMenuItem" Header="重做(_R)" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                    <Separator />
                    <MenuItem x:Name="CutMenuItem" Header="剪切(_T)" InputGestureText="Ctrl+X" Click="Cut_Click" />
                    <MenuItem x:Name="CopyMenuItem" Header="复制(_C)" InputGestureText="Ctrl+C" Click="Copy_Click" />
                    <MenuItem x:Name="PasteMenuItem" Header="粘贴(_P)" InputGestureText="Ctrl+V" Click="Paste_Click" />
                    <MenuItem Header="全选(_A)" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                </MenuItem>
                <MenuItem Header="视图(_V)">
                    <MenuItem Header="循环切换视图" InputGestureText="F9" Click="CycleViewMode_Click" />
                    <Separator />
                    <MenuItem x:Name="PreviewOnlyModeMenuItem" Header="仅预览" IsCheckable="True" Click="PreviewOnlyMode_Click" />
                    <MenuItem x:Name="SplitModeMenuItem" Header="编辑 + 预览" IsCheckable="True" IsChecked="True" Click="SplitMode_Click" />
                    <MenuItem x:Name="EditorOnlyModeMenuItem" Header="仅编辑" IsCheckable="True" Click="EditorOnlyMode_Click" />
                    <Separator />
                    <MenuItem x:Name="RecentPaneMenuItem" Header="显示最近文件" IsCheckable="True" Click="RecentPaneToggle_Click" />
                    <MenuItem Header="自定义背景..." Click="BackgroundSettings_Click" />
                </MenuItem>
                <MenuItem Header="帮助(_H)">
                    <MenuItem Header="关于 WIMD" Click="About_Click" />
                </MenuItem>
            </Menu>

            <Grid Grid.Row="1" Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecentPaneColumn" Width="252" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RecentPane" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,10,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="最近打开" />
                                <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="仅保存在这台电脑" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="收起最近文件" Click="CollapseRecentPane_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentFiles, ElementName=RootWindow}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Tag="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource RecentOpenButtonStyle}" Click="OpenRecentFile_Click">
                                                    <StackPanel HorizontalAlignment="Stretch">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#9299AA" Text="{Binding LastOpenedDisplay}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Width="30" Height="30" Margin="2,0,0,0" VerticalAlignment="Center" Tag="{Binding Path}" ToolTip="移出最近文件（不删除原文件）" Style="{StaticResource CompactToolbarButtonStyle}" Click="RemoveRecentFile_Click">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="RecentFilesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#A7ADBC" Text="&#xE81C;" />
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="还没有最近文件" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#9299AA" Text="打开文档后会显示在这里" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,6" Padding="6,3" Style="{StaticResource SurfaceCardStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H1" ToolTip="一级标题 (Ctrl+1)" Tag="1" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H2" ToolTip="二级标题 (Ctrl+2)" Tag="2" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H3" ToolTip="三级标题 (Ctrl+3)" Tag="3" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H4" ToolTip="四级标题 (Ctrl+4)" Tag="4" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H5" ToolTip="五级标题 (Ctrl+5)" Tag="5" Click="Heading_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="H6" ToolTip="六级标题 (Ctrl+6)" Tag="6" Click="Heading_Click" />
                                <Separator Margin="5,4" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" FontWeight="Bold" Content="B" ToolTip="粗体 (Ctrl+B)" Tag="bold" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" FontStyle="Italic" Content="I" ToolTip="斜体 (Ctrl+I)" Tag="italic" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="S̶" ToolTip="删除线" Tag="strike" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="❝" ToolTip="引用" Tag="quote" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="&lt;/&gt;" ToolTip="行内代码" Tag="inline-code" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="代码块" ToolTip="代码块" Tag="code-block" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="链接" ToolTip="插入链接" Tag="link" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="图片" ToolTip="插入图片" Tag="image" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="• 列表" ToolTip="无序列表" Tag="unordered-list" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="1. 列表" ToolTip="有序列表" Tag="ordered-list" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="☑ 任务" ToolTip="任务列表" Tag="task-list" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="表格" ToolTip="插入表格" Tag="table" Click="MarkdownFormat_Click" />
                                <Button Style="{StaticResource MarkdownToolbarButtonStyle}" Content="—" ToolTip="分隔线" Tag="separator" Click="MarkdownFormat_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid x:Name="WorkspaceGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="0" />
                            <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="EditorHost" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,0" BorderBrush="#E7EAF1" BorderThickness="0,0,0,1">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <avalonEdit:TextEditor x:Name="Editor"
                                                       Grid.Row="1"
                                                       Padding="14,10"
                                                       Background="#EFFFFFFF"
                                                       Foreground="#1A2235"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="15"
                                                       ShowLineNumbers="True"
                                                       WordWrap="True"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"
                                                       TextChanged="Editor_TextChanged" />
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

                        <Border x:Name="PreviewHost" Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,0" BorderBrush="#E7EAF1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PanelTitleTextStyle}" Text="实时预览" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="7,2" Background="#E5F8F0" CornerRadius="7">
                                            <TextBlock FontSize="9" Foreground="#257A58" Text="离线安全" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <webView:WebView2 x:Name="Preview" Grid.Row="1" PreviewMouseWheel="Preview_PreviewMouseWheel" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Padding="10,4" Background="#F8FFFFFF" BorderBrush="#DDE2EC" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="准备就绪" />
                    <Border Grid.Column="1" Width="1" Height="12" Margin="10,0" Background="#D9DDE6" />
                    <TextBlock x:Name="PathText" Grid.Column="2" VerticalAlignment="Center" Foreground="#858C9E" Text="未保存" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CaretText" Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="行 1，列 1" />
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="BackgroundSettingsPopup" Placement="Center" PlacementTarget="{Binding ElementName=RootWindow}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="310" Padding="18" Background="#FFFCFD" BorderBrush="#D8DDE8" BorderThickness="1" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.18" ShadowDepth="5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="工作区背景" />
                    <TextBlock Margin="0,5,0,14" Foreground="{StaticResource TextSecondaryBrush}" Text="图片仅从本机读取，不会上传。" />
                    <TextBlock x:Name="BackgroundFileNameText" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" Text="尚未选择图片" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="选择图片" Click="SelectBackground_Click" />
                        <Button x:Name="RemoveBackgroundButton" Style="{StaticResource ToolbarButtonStyle}" Content="移除" Click="RemoveBackground_Click" />
                    </StackPanel>
                    <TextBlock x:Name="BackgroundTransparencyText" Margin="0,14,0,5" Foreground="{StaticResource TextSecondaryBrush}" Text="透明度 82%" />
                    <Slider x:Name="BackgroundTransparencySlider" Minimum="0" Maximum="100" TickFrequency="5" Value="82" ValueChanged="BackgroundTransparencySlider_ValueChanged" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
