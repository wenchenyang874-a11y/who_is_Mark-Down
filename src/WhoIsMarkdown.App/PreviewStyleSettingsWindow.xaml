<Window x:Class="WhoIsMarkdown.App.PreviewStyleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览样式"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="116" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Feature navigation stays in one shared dialog as more style sections arrive. -->
        <ListBox SelectedIndex="0" BorderThickness="0" Background="Transparent"
                 AutomationProperties.Name="样式分类">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="CategorySurface" Padding="10,9" CornerRadius="8"
                                        Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="CategorySurface" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="有序列表" Padding="10,9" />
        </ListBox>
        <StackPanel Grid.Column="2">
            <TextBlock Text="让数字编号更清晰" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,20" Text="只改变预览和 PDF 外观，不改 Markdown 源文。"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="全局默认" FontWeight="SemiBold" />
            <ComboBox x:Name="GlobalStyleComboBox" Margin="0,7,0,5" MinHeight="34"
                      DisplayMemberPath="Label" SelectionChanged="Style_SelectionChanged"
                      AutomationProperties.Name="全局默认编号样式" />
            <TextBlock Text="保存到本机，供以后新开的窗口使用；其他已开窗口不实时同步。"
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Margin="0,18,0,0" Text="当前文件" FontWeight="SemiBold" />
            <ComboBox x:Name="WindowStyleComboBox" Margin="0,7,0,5" MinHeight="34"
                      DisplayMemberPath="Label" SelectionChanged="Style_SelectionChanged"
                      AutomationProperties.Name="当前文件编号样式" />
            <TextBlock x:Name="FileScopeHint" Text="按文件保存在本机，重开后保留。"
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Border Margin="0,20,0,8" Padding="18" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource SurfaceMutedBrush}">
                <StackPanel>
                    <TextBlock Text="当前文件效果示意" Margin="0,0,0,12" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel x:Name="StylePreview" />
                </StackPanel>
            </Border>
            <TextBlock Text="多位数自动撑宽；嵌套和从指定数字开始的列表保留原有顺序。"
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Width="76" Height="32" Margin="0,0,8,0" />
                <Button x:Name="ApplyStylesButton" Content="应用" Width="76" Height="32" Margin="0,0,8,0" Click="Apply_Click" />
                <Button x:Name="ConfirmStylesButton" Content="确定" IsDefault="True" Width="76" Height="32" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
