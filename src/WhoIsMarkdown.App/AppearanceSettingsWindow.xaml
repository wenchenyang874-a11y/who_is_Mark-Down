<Window x:Class="WhoIsMarkdown.App.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WhoIsMarkdown.App.Controls"
        Title="外观设置" Width="820" Height="760" MinWidth="680" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" MinWidth="92" Padding="14,12" Margin="0,0,16,8" CornerRadius="8" Background="Transparent">
                            <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" /><Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ToolbarHoverBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="让写作更合心意" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="主题、字体与背景，都在这里。点击应用即可试用，不关闭窗口。" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl x:Name="SettingsPages" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="主题">
                <ScrollViewer x:Name="ThemePageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="界面主题" />
                        <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource TextSecondaryBrush}" Text="低饱和配色，照顾长时间阅读。" />
                        <ListBox x:Name="ThemeListBox" SelectedValuePath="Theme" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" AutomationProperties.Name="选择界面主题">
                            <!-- The page owns scrolling. A nested ListBox ScrollViewer
                                 swallowed wheel input even when it had no scroll range. -->
                            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ThemeCard" Margin="0,0,10,12" Padding="12" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}" Background="{Binding Colors.Surface}"><ContentPresenter /></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThemeCard" Property="Opacity" Value="0.88" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel>
                                    <Border CornerRadius="5" Background="{Binding Colors.Background}" Height="44" Padding="10,7">
                                        <Grid><Border Width="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding Colors.Accent}" /><TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Colors.Text}" Text="Aa · 文" /></Grid>
                                    </Border>
                                    <TextBlock Margin="0,9,0,0" FontWeight="SemiBold" Foreground="{Binding Colors.Text}" Text="{Binding Name}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{Binding Colors.Secondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="字体">
                <ScrollViewer x:Name="FontPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="字体与字号" />
                        <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="内置开源字体无需安装；也可选择本机字体。直接输入中文或英文名筛选，再点击候选。" />
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="编辑区字体" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="EditorFontComboBox" Margin="0,0,12,0" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" AutomationProperties.Name="搜索并选择编辑区字体" SelectionChanged="FontSelectionChanged" />
                            <ComboBox x:Name="EditorFontSizeComboBox" Grid.Column="1" IsEditable="True" SelectionChanged="FontSelectionChanged" AutomationProperties.Name="编辑区字号" />
                        </Grid>
                        <TextBlock Margin="0,20,0,8" FontWeight="SemiBold" Text="预览区字体" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="PreviewFontComboBox" Margin="0,0,12,0" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" AutomationProperties.Name="搜索并选择预览区字体" SelectionChanged="FontSelectionChanged" />
                            <ComboBox x:Name="PreviewFontSizeComboBox" Grid.Column="1" IsEditable="True" SelectionChanged="FontSelectionChanged" AutomationProperties.Name="预览区字号" />
                        </Grid>
                        <Border Margin="0,24,0,0" Padding="18" Style="{DynamicResource SurfaceCardStyle}"><StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="字体试读" />
                            <TextBlock x:Name="EditorFontPreviewText" Margin="0,12,0,0" TextWrapping="Wrap" Text="# WIMD · 清晰专注 0123456789&#x0a;const answer = 42;  // Hello, 世界" />
                            <TextBlock x:Name="PreviewFontPreviewText" Margin="0,18,0,0" TextWrapping="Wrap" Text="风过竹梢，月落书页。&#x0a;把灵感留在这里，让文字自然流淌。" />
                        </StackPanel></Border>
                        <TextBlock Margin="0,18,0,8" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="内置字体均按 SIL OFL 1.1 原样分发，许可证与版权声明随软件附带。本机字体仅引用，不复制或分发；请按其自身许可使用。" />
                        <Button HorizontalAlignment="Left" Padding="12,6" Content="查看字体许可证与来源" Click="FontLicenses_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="背景"><ScrollViewer x:Name="BackgroundPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><controls:BackgroundSettingsControl x:Name="BackgroundPage" /></ScrollViewer></TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button x:Name="RestoreDefaultsButton" HorizontalAlignment="Left" Padding="14,7" Content="恢复默认" Click="RestoreDefaults_Click" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="78" Padding="14,7" IsCancel="True" Content="取消" />
                <Button x:Name="ApplyButton" Margin="10,0,0,0" MinWidth="78" Padding="14,7" Content="应用" Click="Apply_Click" />
                <Button x:Name="SaveButton" Margin="10,0,0,0" MinWidth="78" Padding="14,7" IsDefault="True" Content="保存" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
