<Window x:Class="WhoIsMarkdown.App.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观与字体"
        Width="560"
        Height="590"
        MinWidth="520"
        MinHeight="550"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="外观与字体" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="主题与字体仅保存在本机，可随时恢复默认。" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="16" Style="{DynamicResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="界面主题" />
                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="System" Content="跟随 Windows" />
                    <ComboBoxItem Tag="Light" Content="明亮" />
                    <ComboBoxItem Tag="Dark" Content="深色" />
                    <ComboBoxItem Tag="Warm" Content="暖色护眼" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="16" Style="{DynamicResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="编辑区字体" />
                <ComboBox x:Name="EditorFontComboBox" Grid.Column="1"
                          AutomationProperties.Name="搜索并选择编辑区字体"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          ToolTip="输入中文名或英文名筛选，再点击候选字体"
                          SelectionChanged="FontSelectionChanged" />
                <ComboBox x:Name="EditorFontSizeComboBox" Grid.Column="3" IsEditable="True" SelectionChanged="FontSelectionChanged">
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">12</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">14</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">15</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">18</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:String>
                </ComboBox>

                <TextBlock Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="预览区字体" />
                <ComboBox x:Name="PreviewFontComboBox" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0"
                          AutomationProperties.Name="搜索并选择预览区字体"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          ToolTip="输入中文名或英文名筛选，再点击候选字体"
                          SelectionChanged="FontSelectionChanged" />
                <ComboBox x:Name="PreviewFontSizeComboBox" Grid.Row="1" Grid.Column="3" Margin="0,14,0,0" IsEditable="True" SelectionChanged="FontSelectionChanged">
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">12</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">14</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">18</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">22</sys:String>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="可直接输入中文名或英文名实时筛选，再点击候选字体。WIMD 只引用本机已安装字体，不附带、复制、上传或再分发字体文件。" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" MinHeight="118" Padding="18" Style="{DynamicResource SurfaceCardStyle}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="预览" />
                <TextBlock x:Name="EditorFontPreviewText" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="编辑：# WIMD Markdown 0123456789" />
                <TextBlock x:Name="PreviewFontPreviewText" Margin="0,10,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="预览：清晰、专注、离线优先" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="88" Padding="14,7" Content="恢复默认" Click="RestoreDefaults_Click" />
            <Button Margin="10,0,0,0" MinWidth="88" Padding="14,7" IsCancel="True" Content="取消" />
            <Button Margin="10,0,0,0" MinWidth="88" Padding="14,7" Content="应用" Click="Apply_Click" />
            <Button Margin="10,0,0,0" MinWidth="88" Padding="14,7" IsDefault="True" Content="保存" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
