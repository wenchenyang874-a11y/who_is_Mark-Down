<Window x:Class="WhoIsMarkdown.App.BackgroundSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作区背景"
        Width="356"
        Height="270"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="18"
            Padding="18"
            Background="#FFFCFD"
            BorderBrush="#D8DDE8"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.16" ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#1A2235" Text="工作区背景" />
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="关闭背景设置"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="×"
                        Cursor="Hand"
                        FontFamily="Segoe UI, Microsoft YaHei UI"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="#596278"
                        Click="Close_Click" />
            </Grid>
            <TextBlock Grid.Row="1" Margin="0,3,0,14" Foreground="#6D768B" Text="图片仅从本机读取，不会上传。" />
            <TextBlock x:Name="BackgroundFileNameText" Grid.Row="2" Margin="0,0,0,10" Foreground="#1A2235" Text="尚未选择图片" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="SelectBackgroundButton" AutomationProperties.Name="选择图片" Padding="12,6" Content="选择图片" Cursor="Hand" Click="SelectBackground_Click" />
                <Button x:Name="RemoveBackgroundButton" Margin="8,0,0,0" Padding="12,6" Content="移除" Cursor="Hand" Click="RemoveBackground_Click" />
            </StackPanel>
            <TextBlock x:Name="BackgroundVisibilityText" Grid.Row="4" Margin="0,14,0,5" Foreground="#6D768B" Text="背景可见度 18%" />
            <Slider x:Name="BackgroundVisibilitySlider"
                    Grid.Row="5"
                    AutomationProperties.Name="背景可见度"
                    ToolTip="0% 完全隐藏，100% 最清晰"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="5"
                    Value="18"
                    ValueChanged="BackgroundVisibilitySlider_ValueChanged" />
        </Grid>
    </Border>
</Window>
