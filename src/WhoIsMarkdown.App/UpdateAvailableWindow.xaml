<Window x:Class="WhoIsMarkdown.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIMD 更新"
        Width="620"
        Height="520"
        MinWidth="540"
        MinHeight="440"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="发现新版本" />
            <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,16,0,8" FontWeight="SemiBold" Text="更新说明" />
        <TextBox x:Name="ReleaseNotesTextBox"
                 Grid.Row="2"
                 Padding="14"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="DownloadStatusText" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="安装包来自项目的 GitHub Release，下载后会校验大小和 SHA-256。" />
            <ProgressBar x:Name="DownloadProgressBar" Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="WIMD 不会后台静默安装。点击后仅下载此版本安装包；校验通过并再次保存当前文档后才会启动安装程序。" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="LaterButton" MinWidth="96" Padding="14,7" IsCancel="True" Content="稍后再说" />
            <Button x:Name="DownloadButton" Margin="10,0,0,0" MinWidth="126" Padding="14,7" IsDefault="True" Content="下载并安装" Click="Download_Click" />
        </StackPanel>
    </Grid>
</Window>
